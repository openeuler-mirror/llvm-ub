     return 1; /* purecov: inspected */
+  return 0;
+} /* write_keys */
+
+static int write_keys_only(Sort_param *param, Filesort_info *fs_info,
+  uint count, IO_CACHE *chunk_file, IO_CACHE *tempfile,
+  std::vector<std::tuple<uint, int, int, bool, bool, bool>> &sf_arrays,
+  std::vector<bisheng::id_type> &actors) {
+  Merge_chunk merge_chunk;
+  DBUG_TRACE;
+
+  count = std::min((size_t)count, (size_t)param->max_rows);
+
+  if (!my_b_inited(chunk_file) &&
+      open_cached_file(chunk_file, mysql_tmpdir, TEMP_PREFIX, DISK_BUFFER_SIZE,
+                       MYF(MY_WME)))
+    return 1;
+
+  if (!my_b_inited(tempfile) &&
+      open_cached_file(tempfile, mysql_tmpdir, TEMP_PREFIX, DISK_BUFFER_SIZE,
+                       MYF(MY_WME)))
+    return 1; /* purecov: inspected */
+
+  // Check that we wont have more chunks than we can possibly keep in memory.
+  if (my_b_tell(chunk_file) + sizeof(Merge_chunk) > (ulonglong)UINT_MAX)
+    return 1; /* purecov: inspected */
 
+  if (tempfile->file == -1) {
+    if (real_open_cached_file(tempfile)) {
+      return 1;
+    }
+    char path[100];
+    snprintf(path, 100, "/proc/self/fd/%d", tempfile->file);
+    int ret = linkat(tempfile->file, path, AT_FDCWD, my_filename(tempfile->file), AT_SYMLINK_FOLLOW);
+    if (ret < 0) {
+      assert(0);
+    }
+  }
+
+  merge_chunk.set_file_position(my_b_tell(tempfile));
+  merge_chunk.set_rowcount(static_cast<ha_rows>(count));
+
+  std::vector<size_t> pointers;
+  pointers.reserve(count);
+  size_t bytes_to_read = 0;
+  for (uint ix = 0; ix < count; ++ix) {
+    uchar *record = fs_info->get_sorted_record(ix);
+    size_t rec_length = param->get_record_length(record);
+
+    pointers.emplace_back(rec_length);
+    bytes_to_read += rec_length;
+
+    if (my_b_write(tempfile, record, rec_length))
+      return 1; /* purecov: inspected */
+  }
+
+  if (my_b_write(chunk_file, pointer_cast<uchar *>(&merge_chunk),
+                 sizeof(merge_chunk)))
+    return 1; /* purecov: inspected */
+
+  bisheng::id_type actor =
+    bisheng::createNew<RemoteSortActor>(RemoteSortActor::getRemoteActor,
+      fs_info->max_size_in_bytes(),
+      pointers,
+      param->max_record_length(),
+      param->max_compare_length(),
+      param->fixed_res_length,
+      param->m_remove_duplicates,
+      sf_arrays,
+      param->use_hash,
+      param->using_addon_fields(),
+      param->using_packed_addons(),
+      param->sum_ref_length,
+      count,
+      param->max_rows,
+      my_filename(tempfile->file),
+      merge_chunk.file_position(),
+      bytes_to_read
+    );
+
+
+  actors.push_back(actor);
   return 0;
 } /* write_keys */
 
