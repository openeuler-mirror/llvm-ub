+class RemoteSortActor {
+public:
+  Filesort_buffer m_filesort;
+  Sort_param m_param;
+  std::vector<st_sort_field> m_sortorder;
+  std::vector<size_t> m_pointers;
+  size_t m_num_input_rows;
+  size_t m_max_output_rows;
+
+  std::string m_file_name;
+  File m_file;
+  my_off_t m_file_position;
+  size_t m_bytes_to_read;
+
+  RemoteSortActor() {
+    m_param.addon_fields = nullptr;
+    m_file = -1;
+  }
+  ~RemoteSortActor() {
+    m_filesort.free_sort_buffer();
+    if (m_param.addon_fields != nullptr) {
+      delete m_param.addon_fields;
+    }
+    if (m_file != -1) {
+      (void)close(m_file);
+    }
+  }
+
+  static RemoteSortActor* getRemoteActor(
+    size_t memory_available,
+    std::vector<size_t> pointers,
+    uint fixed_rec_length,
+    uint fixed_sort_length,
+    uint fixed_res_length,
+    bool remove_duplicates,
+    std::vector<std::tuple<uint, int, int, bool, bool, bool>> local_sortorder,
+    bool use_hash,
+    bool using_addon_fields,
+    bool using_packed_addons,
+    uint sum_ref_length,
+    size_t num_input_rows,
+    size_t max_output_rows,
+    std::string file_name,
+    my_off_t file_position,
+    size_t bytes_to_read
+    ) {
+
+    RemoteSortActor* actor = new RemoteSortActor();
+
+    Sort_param& param = actor->m_param;
+    param.m_remove_duplicates = remove_duplicates;
+
+    actor->m_sortorder.reserve(local_sortorder.size());
+    for (auto sortorder : local_sortorder) {
+      auto [
+        length,
+        result_type,
+        field_type,
+        reverse,
+        is_varlen,
+        maybe_null] = sortorder;
+      actor->m_sortorder.push_back({nullptr,
+        length,
+        (Item_result)result_type,
+        (enum_field_types)field_type,
+        reverse,
+        is_varlen,
+        maybe_null
+      });
+    }
+    param.init_for_unittest(
+      make_array(actor->m_sortorder.data(), actor->m_sortorder.size()));
+    param.use_hash = use_hash;
+    if (using_addon_fields) {
+      Addon_fields_array empty_array((Sort_addon_field*)-1, 0);
+      Addon_fields* addon_fields = new Addon_fields(empty_array);
+      addon_fields->set_using_packed_addons(using_packed_addons);
+      param.addon_fields = addon_fields;
+      param.set_using_packed_addons(using_packed_addons);
+    }
+    param.sum_ref_length = sum_ref_length;
+    param.fixed_res_length = fixed_res_length;
+    param.set_max_record_length(fixed_rec_length);
+    param.set_max_compare_length(fixed_sort_length);
+
+    Filesort_buffer& filesort = actor->m_filesort;
+    filesort.set_max_size(memory_available, param.max_record_length());
+
+    actor->m_pointers = std::move(pointers);
+
+    actor->m_num_input_rows = num_input_rows;
+    actor->m_max_output_rows = max_output_rows;
+
+    actor->m_file_name = file_name;
+    actor->m_file_position = file_position;
+    actor->m_bytes_to_read = bytes_to_read;
+
+    return actor;
+  }
+
+  uint Sort() {
+
+    m_file = open(m_file_name.c_str(), O_RDWR | O_CLOEXEC, S_IRUSR | S_IWUSR);
+    if (m_file == -1) {
+      assert(0);
+    }
+
+    Bounds_checked_array<uchar> buffer = m_filesort.get_contiguous_buffer();
+    if (mysql_file_pread(m_file, buffer.array(),
+      m_bytes_to_read, m_file_position, MYF_RW)) {
+      return (uint)-1;
+    }
+
+    for (auto num_bytes : m_pointers) {
+      m_filesort.commit_used_memory(num_bytes);
+    }
+
+    uchar* block = (uchar *)my_malloc(
+      key_memory_Filesort_buffer_sort_keys, m_bytes_to_read, MYF(0));
+    size_t count = m_filesort.sort_buffer(&m_param, m_num_input_rows, m_max_output_rows);
+    uchar* ptr = block;
+    for (uint ix = 0; ix < count; ++ix) {
+      uchar *record = m_filesort.get_sorted_record(ix);
+      size_t rec_length = m_param.get_record_length(record);
+
+      memcpy(ptr, record, rec_length);
+      ptr += rec_length;
+    }
+
+    if (mysql_file_pwrite(m_file, block,
+      m_bytes_to_read, m_file_position, MYF(MY_WME) | MY_NABP)) {
+      return (uint)-1;
+    }
+
+    close(m_file);
+    m_file = -1;
+    m_filesort.free_sort_buffer();
+    my_free(block);
+    return 0;
+  }
+
+};
+
